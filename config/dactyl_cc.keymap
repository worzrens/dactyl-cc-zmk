#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF 0
#define FN  1
#define BTM 2


&kscan0 {
       debounce-press-ms = <30>;
       debounce-release-ms = <30>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
&gresc       &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp MINUS
&lt FN TAB   &kp Q       &kp W       &kp E       &kp R       &kp T       &kp Y       &kp U       &kp I       &kp O       &kp P       &kp BSLH
&none        &kp A       &kp S       &kp D       &kp F       &kp G       &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp SQT
&mo BTM      &kp Z       &kp X       &kp C       &kp V       &kp B       &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp BSLH
             &kp LG(SPACE) &none     &kp LEFT    &kp RIGHT                            &kp DOWN    &kp UP      &none       &kp PSCRN
                                               &kp EQUAL   &kp LGUI    &none       &mt LCTRL RET
                                                           &kp LALT    &none
                                    &kp LSHFT  &none       &kp LCTRL   &lt DEF RET  &mt LSHIFT SPACE &kp BSPC
            >;
        };

        fn_layer {
            display-name = "fn";
            bindings = <
&none &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&none &none &none &none &none &none &none &none &none &none &none &kp F12
&none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none
      &none &none &none &none                         &none &none &none &none
                              &none &none &none &none
                                          &none &none
                   &none &none &none &none &none &none
            >;
        };

        bt_media_layer {
            display-name = "BT+Media";
            bindings = <
&none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none
&bt BT_CLR &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none
      &none &none &none &none                         &none &none &none &none
                              &none &none &none &none
                                          &none &none
                   &none &none &none &none &none &none
            >;
        };
    };
};
