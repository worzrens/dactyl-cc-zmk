#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF 0
#define FN  1
#define SYM 2
#define BTM 3


&kscan0 {
       debounce-press-ms = <30>;
       debounce-release-ms = <30>;
};

/ {
    behaviors {
        /*
         * esc_grave:
         * - tap: ESC
         * - hold: GRAVE
         * - tap+hold/chord: ESC
         */
        esc_grave: esc_grave_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;    // Time required to trigger the Hold action (Grave)
            quick-tap-ms = <200>;      // Time window to trigger the Tap-and-Hold repeat (Esc)
            bindings = <&kp &kp>;   // Allows normal keys for both hold and tap
        };

        /*
         * bspc_sym_ht:
         * - tap: BSPC
         * - hold: MO(SYM)
         * - tap+hold/chord: BSPC
         */
        bspc_sym_ht: bspc_sym_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo SYM &kp BSPC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
&esc_grave    &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp MINUS
&lt FN TAB   &kp Q       &kp W       &kp E       &kp R       &kp T       &kp Y       &kp U       &kp I       &kp O       &kp P       &kp LBKT
&trans       &kp A       &kp S       &kp D       &kp F       &kp G       &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp SQT
&mo BTM      &kp Z       &kp X       &kp C       &kp V       &kp B       &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp BSLH
             &kp LG(SPACE) &trans    &kp LEFT    &kp RIGHT                            &kp DOWN    &kp UP      &trans      &kp PSCRN
                                               &kp EQUAL   &kp LGUI    &trans      &mt LCTRL RET
                                                           &kp LALT    &kp TAB
                                    &kp LSHFT  &kp SPACE    &kp LCTRL   &lt SYM RET  &mt LSHIFT SPACE &bspc_sym_ht
            >;
        };

        fn_layer {
            display-name = "fn";
            bindings = <
&trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp F12
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
      &trans &trans &trans &trans                         &trans &trans &trans &trans
                              &trans &trans &trans &trans
                                          &trans &trans
                   &trans &trans &trans &trans &trans &trans
            >;
        };

        symbols_layer {
            display-name = "Symbols";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp C_VOL_UP
&trans &trans &trans &trans &trans &kp EQUAL &kp MINUS &trans &trans &trans &trans &kp C_VOL_DN
&trans &trans &trans &trans &trans &trans &trans &trans &kp LBKT &kp RBKT &trans &kp C_MUTE
      &trans &trans &trans &trans                         &trans &trans &trans &trans
                              &trans &trans &trans &trans
                                          &trans &trans
                   &trans &trans &trans &trans &trans &trans
            >;
        };

        bt_media_layer {
            display-name = "BT+Media";
            bindings = <
&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&bt BT_CLR &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
      &trans &trans &trans &trans                         &trans &trans &trans &trans
                              &trans &trans &trans &trans
                                          &trans &trans
                   &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
